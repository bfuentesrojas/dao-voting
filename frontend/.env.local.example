# Variables de entorno para el frontend
# Copiar este archivo a .env.local y completar con las direcciones reales

# Configuración de red
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337

# Direcciones de contratos (obtener después del despliegue)
NEXT_PUBLIC_DAO_ADDRESS=0x...
NEXT_PUBLIC_FORWARDER_ADDRESS=0x...

# Configuración del relayer
# Clave privada de la cuenta que pagará el gas de las meta-transacciones
RELAYER_PRIVATE_KEY=0x...

# Dirección del relayer (derivada de RELAYER_PRIVATE_KEY)
# Se puede obtener con: cast wallet address --private-key $RELAYER_PRIVATE_KEY
RELAYER_ADDRESS=0x...

# Configuración del daemon (opcional, para API route /api/daemon)
DAEMON_PRIVATE_KEY=0x...

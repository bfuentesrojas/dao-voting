{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "ignorePatterns": [
    "next-env.d.ts",
    ".next/**",
    "node_modules/**",
    "out/**"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/triple-slash-reference": "off",
    "react/no-unescaped-entities": "off"
  }
}

